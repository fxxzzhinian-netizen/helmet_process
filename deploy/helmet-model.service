[Unit]
Description=Helmet GPU inference service
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/helmet-review/current
EnvironmentFile=/opt/helmet-review/shared/service.env
ExecStart=/opt/helmet-review/venv/bin/python -X utf8 -m model.server --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
